<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- NuGet metadata -->
    <PackageId>Mostlylucid.Avalonia.UITesting</PackageId>
    <Version>1.6.0</Version>
    <Authors>Scott Galloway</Authors>
    <Description>UI testing for Avalonia desktop apps: Playwright-style locators with auto-retry, auto-waiting expectations, real pointer/touch/gesture input (click, drag, wheel, pinch, rotate), YAML script playback, screenshot/region/control snapshots (+ composite windows), GIF/MP4 recording, an interactive REPL and an MCP server. HeadlessRender.SettleAsync realizes deferred/virtualized/animated content before capture — including drag-driven Dock docking/splitting.</Description>
    <PackageReleaseNotes>1.6.0: drag input verified against Dock.Avalonia tab drag/dock/split; chord-key PressKey (Ctrl+Shift+P); docs refreshed for locators, expectations, gestures, composite screenshots, REPL and MCP.</PackageReleaseNotes>
    <PackageTags>avalonia;ui-testing;screenshots;snapshots;automation;desktop;mcp;drag;gestures</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/scottgal/lucidRESUME</PackageProjectUrl>
    <RepositoryUrl>https://github.com/scottgal/lucidRESUME</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
    <None Include="icon.png" Pack="true" PackagePath="" />
    <None Include="examples\**\*.yaml" Pack="true" PackagePath="content\examples" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.4" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.4" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.4" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.4" />
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="YamlDotNet" Version="17.0.1" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.5" />

    <!-- Override transitive Tmds.DBus.Protocol 0.21.2 (GHSA-xrw6-gwf8-vvr9). Avalonia 11.3.x pulls 0.21.2. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.92.0" />
  </ItemGroup>

</Project>
