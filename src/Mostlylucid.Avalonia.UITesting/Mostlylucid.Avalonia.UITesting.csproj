<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- NuGet metadata -->
    <PackageId>Mostlylucid.Avalonia.UITesting</PackageId>
    <Version>1.7.1</Version>
    <Authors>Scott Galloway</Authors>
    <Description>UI testing for Avalonia desktop apps: Playwright-style locators with auto-retry, auto-waiting expectations, real pointer/touch/gesture input (click, drag, wheel, pinch, rotate), YAML script playback, screenshot/region/control snapshots (+ composite windows AND open pop-ups), drop-down driving (open + select), GIF/MP4 recording, an interactive REPL and an MCP server. HeadlessRender.SettleAsync realizes deferred/virtualized/animated content before capture — including drag-driven Dock docking/splitting.</Description>
    <PackageReleaseNotes>1.7.1: no functional changes from 1.7.0 — versioned for lucidVIEW v4.2.0 editor integration. 1.7.0: drop-down support — OpenDropDown + SelectDropDownItem actions drive ComboBox/AutoCompleteBox lists deterministically; Composite screenshots now capture open pop-ups; TypeText now targets AutoCompleteBox and any control wrapping a TextBox.</PackageReleaseNotes>
    <PackageTags>avalonia;ui-testing;screenshots;snapshots;automation;desktop;mcp;drag;gestures;dropdown;popup</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/scottgal/lucidRESUME</PackageProjectUrl>
    <RepositoryUrl>https://github.com/scottgal/lucidRESUME</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
    <None Include="icon.png" Pack="true" PackagePath="" />
    <None Include="examples\**\*.yaml" Pack="true" PackagePath="content\examples" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />

    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>

</Project>
