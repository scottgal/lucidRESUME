<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:lucidRESUME.ViewModels"
        xmlns:local="using:lucidRESUME"
        xmlns:fi="using:FluentIcons.Avalonia.Fluent"
        xmlns:fic="using:FluentIcons.Common"
        x:DataType="vm:MainWindowViewModel"
        x:Class="lucidRESUME.MainWindow"
        Title="lucidRESUME" Width="1200" Height="800"
        Icon="avares://lucidRESUME/Assets/lucidresume.png"
        MinWidth="900" MinHeight="600"
        DragDrop.AllowDrop="True">

  <Window.Styles>
    <Style Selector="Button.nav-btn">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="Foreground" Value="{DynamicResource LrNavTextBrush}"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style Selector="Button.nav-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LrNavHoverBgBrush}"/>
    </Style>
  </Window.Styles>

  <Window.Resources>
    <local:NavIsActiveConverter x:Key="NavIsActive"/>
  </Window.Resources>

  <Grid ColumnDefinitions="190,*">
    <Border Background="{DynamicResource LrNavBgBrush}" Padding="12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,12,0,8">
          <Button Classes="nav-btn" Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="Profile"/>
          <Button Classes="nav-btn" Content="Help" Command="{Binding NavigateCommand}" CommandParameter="Help"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="6">
            <TextBlock FontSize="20" Margin="8,16,0,24"><Run Text="lucid" FontStyle="Italic" Foreground="{DynamicResource LrAccentBlueBrush}"/><Run Text="RESUME" FontWeight="Bold"/></TextBlock>
            <TextBlock Text="YOUR WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource LrSubtleTextBrush}" Margin="8,0,0,8"/>
            <Panel>
              <Border Background="{DynamicResource LrNavHoverBgBrush}" CornerRadius="6" IsVisible="{Binding SelectedNav, Converter={StaticResource NavIsActive}, ConverterParameter=CareerHome}"/>
              <Border Width="3" HorizontalAlignment="Left" Background="{DynamicResource LrNavAccentBrush}" IsVisible="{Binding SelectedNav, Converter={StaticResource NavIsActive}, ConverterParameter=CareerHome}"/>
              <Button Classes="nav-btn" Command="{Binding NavigateCommand}" CommandParameter="CareerHome" Padding="12,12" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="4"><TextBlock Text="My career" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Write and strengthen evidence" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource LrSubtleTextBrush}"/></StackPanel>
              </Button>
            </Panel>
            <Panel>
              <Border Background="{DynamicResource LrNavHoverBgBrush}" CornerRadius="6" IsVisible="{Binding SelectedNav, Converter={StaticResource NavIsActive}, ConverterParameter=Jobs}"/>
              <Border Width="3" HorizontalAlignment="Left" Background="{DynamicResource LrNavAccentBrush}" IsVisible="{Binding SelectedNav, Converter={StaticResource NavIsActive}, ConverterParameter=Jobs}"/>
              <Button Classes="nav-btn" Command="{Binding NavigateCommand}" CommandParameter="Jobs" Padding="12,12" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="4"><TextBlock Text="Jobs" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Add, review and create a resume" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource LrSubtleTextBrush}"/></StackPanel>
              </Button>
            </Panel>
            <Panel>
              <Border Background="{DynamicResource LrNavHoverBgBrush}" CornerRadius="6" IsVisible="{Binding SelectedNav, Converter={StaticResource NavIsActive}, ConverterParameter=Generated}"/>
              <Border Width="3" HorizontalAlignment="Left" Background="{DynamicResource LrNavAccentBrush}" IsVisible="{Binding SelectedNav, Converter={StaticResource NavIsActive}, ConverterParameter=Generated}"/>
              <Button Classes="nav-btn" Command="{Binding NavigateCommand}" CommandParameter="Generated" Padding="12,12" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="4"><TextBlock Text="Saved resumes" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Review and export versions" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource LrSubtleTextBrush}"/></StackPanel>
              </Button>
            </Panel>
            <Panel>
              <Border Background="{DynamicResource LrNavHoverBgBrush}" CornerRadius="6" IsVisible="{Binding SelectedNav, Converter={StaticResource NavIsActive}, ConverterParameter=Pipeline}"/>
              <Border Width="3" HorizontalAlignment="Left" Background="{DynamicResource LrNavAccentBrush}" IsVisible="{Binding SelectedNav, Converter={StaticResource NavIsActive}, ConverterParameter=Pipeline}"/>
              <Button Classes="nav-btn" Command="{Binding NavigateCommand}" CommandParameter="Pipeline" Padding="12,12" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="4"><TextBlock Text="Applications" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Track your progress" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource LrSubtleTextBrush}"/></StackPanel>
              </Button>
            </Panel>
            <Expander Header="More tools" Margin="0,18,0,0" HorizontalAlignment="Stretch">
              <StackPanel Spacing="2" Margin="0,8,0,0">
                <Button Classes="nav-btn" Content="Import sources" Command="{Binding NavigateCommand}" CommandParameter="Resume"/>
                <Button Classes="nav-btn" Content="Discover jobs / hiring" Command="{Binding NavigateCommand}" CommandParameter="Discover"/>
                <Button Classes="nav-btn" Content="Evidence explorer" Command="{Binding NavigateCommand}" CommandParameter="MyData"/>
                <Button Classes="nav-btn" Content="Career planning" Command="{Binding NavigateCommand}" CommandParameter="Career"/>
                <Button Classes="nav-btn" Content="Advanced evidence editor" Command="{Binding NavigateCommand}" CommandParameter="JobML"/>
              </StackPanel>
            </Expander>
            <Expander Header="Service status" HorizontalAlignment="Stretch">
              <StackPanel Spacing="5" Margin="8,8,0,0">
                <TextBlock Text="{Binding EmbeddingLabel}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource LrSubtleTextBrush}"/>
                <TextBlock Text="{Binding NerLabel}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource LrSubtleTextBrush}"/>
                <TextBlock Text="{Binding OllamaLabel}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource LrSubtleTextBrush}"/>
                <TextBlock Text="{Binding DoclingLabel}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource LrSubtleTextBrush}"/>
                <TextBlock Text="{Binding StoreLabel}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource LrSubtleTextBrush}"/>
                <TextBlock Text="{Binding WarningMessage}" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource LrAccentYellowBrush}"/>
              </StackPanel>
            </Expander>
            <Border IsVisible="{Binding HasNotifications}" Background="{DynamicResource LrAccentBlueBgBrush}" Padding="8" CornerRadius="6">
              <TextBlock Text="{Binding NotificationMessage}" TextWrapping="Wrap" FontSize="11"/>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>
  </Grid>
</Window>
