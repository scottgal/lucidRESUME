<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:lucidRESUME.ViewModels.Pages"
             xmlns:controls="using:lucidRESUME.Views.Controls"
             x:DataType="vm:ApplyPageViewModel"
             x:Class="lucidRESUME.Views.Pages.ApplyPage">

  <Grid ColumnDefinitions="*,*" Margin="16,12">

    <!-- LEFT: job input form -->
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" Margin="0,0,12,0">

      <!-- Header -->
      <TextBlock Grid.Row="0" Text="Project Resume" FontSize="18" FontWeight="Bold"
                 Foreground="{DynamicResource LrPrimaryTextBrush}" Margin="0,0,0,16"/>

      <!-- Projection invariant -->
      <Border Grid.Row="1" Background="{DynamicResource LrAccentYellowBgBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
        <TextBlock Text="Human prose stays human-owned. JobML adds evidence-linked machine detail. Projection never re-infers or rewrites either one."
                   Foreground="{DynamicResource LrAccentPeachBrush}" FontSize="12" TextWrapping="Wrap"/>
      </Border>

      <!-- Coverage summary -->
      <Border Grid.Row="2" Background="{DynamicResource LrCardBgBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10"
              IsVisible="{Binding HasCoverage}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Foreground="{DynamicResource LrAccentBlueBrush}" FontSize="12" VerticalAlignment="Center">
            <Run Text="Coverage:"/>
            <Run Text="{Binding CoveragePercent}" FontWeight="Bold"/>
            <Run Text="%"/>
          </TextBlock>
          <TextBlock Foreground="{DynamicResource LrAccentRedBrush}" FontSize="12" VerticalAlignment="Center"
                     IsVisible="{Binding GapCount}">
            <Run Text="{Binding GapCount}"/>
            <Run Text="required gap(s)"/>
          </TextBlock>
          <Border Background="{DynamicResource LrBadgeBgBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                  IsVisible="{Binding CompanyTypeLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding CompanyTypeLabel}" FontSize="10" Foreground="{DynamicResource LrAccentPurpleBrush}"/>
          </Border>
        </StackPanel>
      </Border>

      <!-- Job Title -->
      <StackPanel Grid.Row="3" Spacing="4" Margin="0,0,0,10">
        <TextBlock Text="Job Title" Foreground="{DynamicResource LrSecondaryTextBrush}" FontSize="12"/>
        <TextBox x:Name="ProjectionJobTitle" Text="{Binding JobTitle}" PlaceholderText="e.g. Senior Software Engineer"/>
      </StackPanel>

      <!-- Company -->
      <StackPanel Grid.Row="4" Spacing="4" Margin="0,0,0,10">
        <TextBlock Text="Company" Foreground="{DynamicResource LrSecondaryTextBrush}" FontSize="12"/>
        <TextBox x:Name="ProjectionCompany" Text="{Binding Company}" PlaceholderText="e.g. Acme Corp"/>
      </StackPanel>

      <!-- Job Description -->
      <StackPanel Grid.Row="5" Spacing="4" Margin="0,0,0,10">
        <TextBlock Text="Job Description" Foreground="{DynamicResource LrSecondaryTextBrush}" FontSize="12"/>
        <TextBox x:Name="ProjectionJobDescription" Text="{Binding JobDescriptionText}"
                 PlaceholderText="Paste the full job description here…"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Height="200"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
      </StackPanel>

      <!-- Output template -->
      <StackPanel Grid.Row="6" Spacing="4" Margin="0,0,0,10">
        <TextBlock Text="Output Template" Foreground="{DynamicResource LrSecondaryTextBrush}" FontSize="12"/>
        <ComboBox x:Name="OutputTemplateSelector" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"/>
        <TextBlock Text="{Binding SelectedTemplate.Description}" FontSize="10"
                   Foreground="{DynamicResource LrSubtleTextBrush}" TextWrapping="Wrap"/>
      </StackPanel>

      <CheckBox x:Name="IncludeCompactJobMlCheckBox" Grid.Row="7"
                IsChecked="{Binding IncludeCompactJobMl, Mode=TwoWay}"
                Content="Include compact cJobML evidence references"
                ToolTip.Tip="Adds inline citations and a compact machine-readable References section; full editing metadata stays in the ledger"
                Margin="0,0,0,10"/>

      <!-- Projection action -->
      <Grid Grid.Row="8" ColumnDefinitions="*,8,*" Margin="0,4,0,8">
        <Button x:Name="ProjectResumeButton" Grid.Column="0" Grid.ColumnSpan="3"
                Content="Project Resume"
                Command="{Binding SmartCompressCommand}"
                IsEnabled="{Binding !IsTailoring}"
                FontSize="14" FontWeight="Bold"
                Padding="16,12"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                CornerRadius="6"
                ToolTip.Tip="Select relevant accepted evidence and render Markdown plus JobML from the same ledger IDs"/>
      </Grid>

      <!-- Progress bar -->
      <ProgressBar Grid.Row="9" IsVisible="{Binding IsTailoring}"
                   IsIndeterminate="True" Margin="0,0,0,8"/>

      <!-- Status / Error -->
      <StackPanel Grid.Row="10" Spacing="4">
        <TextBlock Text="{Binding CompressionStats}" Foreground="{DynamicResource LrAccentPurpleBrush}" FontSize="11"
                   IsVisible="{Binding CompressionStats, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextWrapping="Wrap"/>
        <TextBlock x:Name="ProjectionStatus" Text="{Binding StatusMessage}" Foreground="{DynamicResource LrSecondaryTextBrush}" FontSize="12"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <Border Background="{DynamicResource LrAccentRedBgBrush}" Padding="10,6" CornerRadius="4"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource LrAccentRedBrush}" TextWrapping="Wrap"/>
        </Border>
      </StackPanel>

    </Grid>

    <!-- RIGHT: projected result -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="12,0,0,0">

      <TextBlock Grid.Row="0" Text="Projected Resume" FontSize="18" FontWeight="Bold"
                 Foreground="{DynamicResource LrPrimaryTextBrush}" Margin="0,0,0,16"/>

      <!-- Empty state -->
      <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                  IsVisible="{Binding !HasResult}">
        <TextBlock Text="Projected resume will appear here." Foreground="{DynamicResource LrSecondaryTextBrush}"
                   FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="Fill in the form and click Project Resume." Foreground="{DynamicResource LrSubtleTextBrush}"
                   FontSize="13" HorizontalAlignment="Center"/>
      </StackPanel>

      <!-- Result -->
      <Border Grid.Row="1" Background="{DynamicResource LrPageBgBrush}" CornerRadius="4"
              IsVisible="{Binding HasResult}">
        <controls:MarkdownViewer x:Name="ProjectedResumeText"
                                 Markdown="{Binding TailoredMarkdown}"
                                 Margin="12"/>
      </Border>

      <!-- Export buttons -->
      <Grid Grid.Row="2" ColumnDefinitions="*,8,*,8,*" Margin="0,8,0,0" IsVisible="{Binding HasResult}">
        <Button x:Name="ExportMarkdownButton" Grid.Column="0" Content="Markdown + JobML" Command="{Binding ExportCommand}"
                CommandParameter="markdown" Padding="12,8"/>
        <Button x:Name="ExportWordButton" Grid.Column="2" Content="Word" Command="{Binding ExportCommand}"
                CommandParameter="docx" Padding="12,8"/>
        <Button x:Name="ExportPdfButton" Grid.Column="4" Content="PDF" Command="{Binding ExportCommand}"
                CommandParameter="pdf" Padding="12,8"/>
      </Grid>

    </Grid>

  </Grid>
</UserControl>
