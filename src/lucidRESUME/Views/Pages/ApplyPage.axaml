<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:lucidRESUME.ViewModels.Pages"
             xmlns:controls="using:lucidRESUME.Views.Controls"
             x:DataType="vm:ApplyPageViewModel"
             x:Class="lucidRESUME.Views.Pages.ApplyPage">

  <Grid ColumnDefinitions="*,*" Margin="16,12">

    <!-- LEFT: job input form -->
    <ScrollViewer Grid.Column="0" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" IsEnabled="{Binding !IsTailoring}">

      <!-- Header -->
      <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
        <TextBlock Text="Generate Resume" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
        <Button Content="Build complete transcript" Margin="12,0,0,4" Command="{Binding BuildCompleteTranscriptCommand}"/>
        <Button x:Name="ViewGeneratedArchive" Content="Archive" Margin="12,0,0,4" Command="{Binding ViewArchiveCommand}"/>
      </WrapPanel>

      <!-- Projection invariant -->
      <Border Grid.Row="1" Background="{DynamicResource LrAccentYellowBgBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
        <TextBlock Text="Your career transcript supplies the facts. Generation selects relevant evidence and can edit its prose while retaining source links."
                   Foreground="{DynamicResource LrAccentPeachBrush}" FontSize="12" TextWrapping="Wrap"/>
      </Border>

      <!-- Coverage summary -->
      <Border Grid.Row="2" Background="{DynamicResource LrCardBgBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10"
              IsVisible="{Binding HasCoverage}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="{Binding CoverageLabel}" Foreground="{DynamicResource LrAccentBlueBrush}" FontSize="12" VerticalAlignment="Center"/>
          <TextBlock Foreground="{DynamicResource LrAccentRedBrush}" FontSize="12" VerticalAlignment="Center"
                     IsVisible="{Binding GapCount}">
            <Run Text="{Binding GapCount}"/>
            <Run Text="unconfirmed must-have(s)"/>
          </TextBlock>
          <Border Background="{DynamicResource LrBadgeBgBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                  IsVisible="{Binding CompanyTypeLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding CompanyTypeLabel}" FontSize="10" Foreground="{DynamicResource LrAccentPurpleBrush}"/>
          </Border>
        </StackPanel>
      </Border>

      <!-- Job Title -->
      <StackPanel Grid.Row="3" Spacing="4" Margin="0,0,0,10">
        <TextBlock Text="Choose a saved job, or paste a description below" FontSize="12"/>
        <ComboBox x:Name="ProjectionSavedJobSelector" ItemsSource="{Binding SavedJobs}" SelectedItem="{Binding SelectedSavedJob}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SavedJobItem">
              <TextBlock><Run Text="{Binding Title}"/><Run Text=" — "/><Run Text="{Binding Company}"/></TextBlock>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="Job Title" Foreground="{DynamicResource LrSecondaryTextBrush}" FontSize="12"/>
        <TextBox x:Name="ProjectionJobTitle" Text="{Binding JobTitle}" PlaceholderText="e.g. Senior Software Engineer"/>
      </StackPanel>

      <!-- Company -->
      <StackPanel Grid.Row="4" Spacing="4" Margin="0,0,0,10">
        <TextBlock Text="Company" Foreground="{DynamicResource LrSecondaryTextBrush}" FontSize="12"/>
        <TextBox x:Name="ProjectionCompany" Text="{Binding Company}" PlaceholderText="e.g. Acme Corp"/>
      </StackPanel>

      <!-- Job Description -->
      <StackPanel Grid.Row="5" Spacing="4" Margin="0,0,0,10">
        <TextBlock Text="Job Description" Foreground="{DynamicResource LrSecondaryTextBrush}" FontSize="12"/>
        <TextBox x:Name="ProjectionJobDescription" Text="{Binding JobDescriptionText}"
                 PlaceholderText="Paste the full job description here…"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Height="200"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
      </StackPanel>

      <!-- Output template -->
      <StackPanel Grid.Row="6" Spacing="4" Margin="0,0,0,10">
        <Grid ColumnDefinitions="*,12,*">
          <StackPanel Spacing="4">
            <TextBlock Text="Length" FontSize="12"/>
            <ComboBox x:Name="ProjectionLengthSelector" ItemsSource="{Binding LengthOptions}" SelectedItem="{Binding SelectedLength}" HorizontalAlignment="Stretch"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4">
            <TextBlock Text="Detail" FontSize="12"/>
            <ComboBox x:Name="ProjectionDetailSelector" ItemsSource="{Binding DetailOptions}" SelectedItem="{Binding SelectedDetail}" HorizontalAlignment="Stretch"/>
          </StackPanel>
        </Grid>
        <TextBlock Text="Tone" FontSize="12"/>
        <ComboBox x:Name="ProjectionToneSelector" ItemsSource="{Binding ToneOptions}" SelectedItem="{Binding SelectedTone}" HorizontalAlignment="Stretch"/>
        <TextBlock Text="Tone changes expression while preserving evidence and ownership. Applied when prose editing is enabled."
                   FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource LrSubtleTextBrush}"/>
        <TextBlock Text="Automatic scales evidence to the job's requirements. Concise, Standard and Extended set the scope; detail controls examples per role. Page count follows the content."
                   FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource LrSubtleTextBrush}"/>
        <TextBlock Text="Output Template" Foreground="{DynamicResource LrSecondaryTextBrush}" FontSize="12"/>
        <ComboBox x:Name="OutputTemplateSelector" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"/>
        <TextBlock Text="{Binding SelectedTemplate.Description}" FontSize="10"
                   Foreground="{DynamicResource LrSubtleTextBrush}" TextWrapping="Wrap"/>
      </StackPanel>

      <CheckBox x:Name="IncludeCompactJobMlCheckBox" Grid.Row="7"
                IsChecked="{Binding IncludeCompactJobMl, Mode=TwoWay}"
                Content="Include compact cJobML evidence references"
                ToolTip.Tip="Adds inline citations and a compact machine-readable References section; full editing metadata stays in the ledger"
                Margin="0,0,0,10"/>

      <!-- Projection action -->
      <Grid Grid.Row="8" ColumnDefinitions="*,8,*" Margin="0,4,0,8">
        <Button x:Name="ProjectResumeButton" Grid.Column="0" Grid.ColumnSpan="3"
                Content="Project Resume"
                Command="{Binding SmartCompressCommand}"
                IsEnabled="{Binding !IsTailoring}"
                FontSize="14" FontWeight="Bold"
                Padding="16,12"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                CornerRadius="6"
                ToolTip.Tip="Select relevant accepted evidence and render Markdown plus JobML from the same ledger IDs"/>
      </Grid>

      <!-- Progress bar -->
      <ProgressBar Grid.Row="9" IsVisible="{Binding IsTailoring}"
                   IsIndeterminate="True" Margin="0,0,0,8"/>

      <!-- Status / Error -->
      <StackPanel Grid.Row="10" Spacing="4">
        <Border Background="{DynamicResource LrAccentYellowBgBrush}" Padding="10,6" CornerRadius="4"
                IsVisible="{Binding EvidenceWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding EvidenceWarning}" TextWrapping="Wrap" FontSize="12"/>
            <Button x:Name="ImproveRoleEvidenceButton" Content="Improve role evidence (optional)"
                    Command="{Binding ImproveEvidenceCommand}" IsVisible="{Binding CanImproveEvidence}"/>
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding CompressionStats}" Foreground="{DynamicResource LrAccentPurpleBrush}" FontSize="11"
                   IsVisible="{Binding CompressionStats, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextWrapping="Wrap"/>
        <TextBlock x:Name="ProjectionStatus" Text="{Binding StatusMessage}" Foreground="{DynamicResource LrSecondaryTextBrush}" FontSize="12"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap"/>
        <Border Background="{DynamicResource LrAccentRedBgBrush}" Padding="10,6" CornerRadius="4"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource LrAccentRedBrush}" TextWrapping="Wrap"/>
        </Border>
      </StackPanel>

    </Grid>
    </ScrollViewer>

    <!-- RIGHT: projected result -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="12,0,0,0">

      <TextBlock Grid.Row="0" Text="Projected Resume" FontSize="18" FontWeight="Bold"
                 Foreground="{DynamicResource LrPrimaryTextBrush}" Margin="0,0,0,16"/>

      <!-- Empty state -->
      <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                  IsVisible="{Binding ShowEmptyResult}">
        <TextBlock Text="Projected resume will appear here." Foreground="{DynamicResource LrSecondaryTextBrush}"
                   FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="Fill in the form and click Project Resume." Foreground="{DynamicResource LrSubtleTextBrush}"
                   FontSize="13" HorizontalAlignment="Center"/>
      </StackPanel>

      <ScrollViewer Grid.Row="1" IsVisible="{Binding HasInterview}" Background="{DynamicResource LrPageBgBrush}">
        <StackPanel Spacing="10" Margin="12" IsEnabled="{Binding !IsTailoring}">
          <Button x:Name="ReturnToProjectionButton" Content="Back to projected resume" Command="{Binding CloseInterviewCommand}" IsVisible="{Binding HasResult}"/>
          <TextBlock Text="Build your role transcript" FontSize="18" FontWeight="Bold"/>
          <TextBlock Text="{Binding InterviewRemaining, StringFormat='Remaining topics: {0}'}" FontSize="12"/>
          <TextBlock Text="{Binding InterviewRequirement}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding InterviewReason}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding InterviewEvidence}" TextWrapping="Wrap" FontStyle="Italic"/>
          <TextBlock Text="{Binding InterviewProbe}" TextWrapping="Wrap"/>
          <TextBlock Text="Which role is this example from?"/>
          <ComboBox x:Name="InterviewRole" ItemsSource="{Binding InterviewRoles}" SelectedItem="{Binding SelectedInterviewRole}" HorizontalAlignment="Stretch"/>
          <TextBlock Text="What was the situation, scope or challenge?" TextWrapping="Wrap"/>
          <TextBox x:Name="InterviewContext" Text="{Binding InterviewContext}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65"/>
          <TextBlock Text="What did you personally do? Include your decisions, tools and contribution alongside the team's." TextWrapping="Wrap"/>
          <TextBox x:Name="InterviewAction" Text="{Binding InterviewAction}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65"/>
          <TextBlock Text="What changed as a result? Use a reliable metric or a concrete qualitative outcome. Leave unknown details blank." TextWrapping="Wrap"/>
          <TextBox x:Name="InterviewOutcome" Text="{Binding InterviewOutcome}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65"/>
          <Border Background="{DynamicResource LrCardBgBrush}" Padding="10" CornerRadius="6">
            <StackPanel Spacing="6">
              <TextBlock Text="Suggested next question" FontWeight="SemiBold"/>
              <ProgressBar IsVisible="{Binding IsAssessingInterview}" IsIndeterminate="True"/>
              <TextBlock x:Name="InterviewNextQuestion" Text="{Binding InterviewNextQuestion}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding InterviewFeedback}" TextWrapping="Wrap" FontSize="11"/>
              <Button Content="Assess answer now" Command="{Binding AssessInterviewCommand}"/>
            </StackPanel>
          </Border>
          <TextBlock Text="Which skills and tools did you actually use? Separate names with commas; saving records them for this role." TextWrapping="Wrap"/>
          <TextBox Text="{Binding InterviewSkills}" PlaceholderText="e.g. Azure Service Bus, C#, OpenTelemetry"/>
          <Button Content="Assemble a prose draft" Command="{Binding DraftInterviewProseCommand}"/>
          <TextBlock Text="Edit and review the account below. Saving adds it to the selected role's complete transcript for future resumes." TextWrapping="Wrap"/>
          <TextBox x:Name="InterviewReviewedProse" Text="{Binding InterviewProse}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"/>
          <Button Content="Save reviewed prose to role" Command="{Binding AcceptInterviewCommand}" IsEnabled="{Binding !IsTailoring}"/>
          <Button Content="Skip this question" Command="{Binding SkipInterviewCommand}" IsEnabled="{Binding !IsTailoring}"/>
          <Button Content="Project with current evidence" IsVisible="{Binding !IsTranscriptBuilder}" Command="{Binding ProjectWithCurrentEvidenceCommand}" IsEnabled="{Binding !IsTailoring}"/>
        </StackPanel>
      </ScrollViewer>

      <!-- Result -->
      <Border Grid.Row="1" Background="{DynamicResource LrPageBgBrush}" CornerRadius="4"
              IsVisible="{Binding ShowProjectedResult}">
        <controls:MarkdownViewer x:Name="ProjectedResumeText"
                                 Markdown="{Binding TailoredMarkdown}"
                                 Margin="12"/>
      </Border>

      <!-- Export buttons -->
      <Grid Grid.Row="2" ColumnDefinitions="*,8,*,8,*" Margin="0,8,0,0" IsVisible="{Binding HasResult}">
        <Button x:Name="ExportMarkdownButton" Grid.Column="0" Content="Markdown + JobML" Command="{Binding ExportCommand}"
                CommandParameter="markdown" Padding="12,8"/>
        <Button x:Name="ExportWordButton" Grid.Column="2" Content="Word" Command="{Binding ExportCommand}"
                CommandParameter="docx" Padding="12,8"/>
        <Button x:Name="ExportPdfButton" Grid.Column="4" Content="PDF" Command="{Binding ExportCommand}"
                CommandParameter="pdf" Padding="12,8"/>
      </Grid>

    </Grid>

  </Grid>
</UserControl>
