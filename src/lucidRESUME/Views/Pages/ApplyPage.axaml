<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:lucidRESUME.ViewModels.Pages"
             xmlns:controls="using:lucidRESUME.Views.Controls"
             x:DataType="vm:ApplyPageViewModel"
             x:Class="lucidRESUME.Views.Pages.ApplyPage">
  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource LrPageBgBrush}">
    <Border Padding="24,20,24,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LrBorderBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="Jobs" FontSize="26" FontWeight="SemiBold"/>
          <TextBlock Text="Paste an advert. Confirm the details. Build your resume." Foreground="{DynamicResource LrSecondaryTextBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <Button x:Name="NewTargetJobButton" Grid.Column="1" Content="+ Add job" Command="{Binding NewJobCommand}" VerticalAlignment="Center" Padding="18,10"/>
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="230,*">
      <Border Background="{DynamicResource LrSurfaceBgBrush}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource LrBorderBrush}">
        <Grid RowDefinitions="Auto,*,Auto" Margin="14">
          <TextBlock Text="SAVED JOBS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource LrSecondaryTextBrush}" Margin="0,4,0,12"/>
          <ListBox x:Name="ProjectionSavedJobSelector" Grid.Row="1" ItemsSource="{Binding SavedJobs}" SelectedItem="{Binding SelectedSavedJob}"
                   Background="Transparent" BorderThickness="0" IsEnabled="{Binding !IsWorkingOnJob}">
            <ListBox.ItemTemplate><DataTemplate x:DataType="vm:SavedJobItem">
              <StackPanel Spacing="4" Margin="2,8">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Company}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource LrSecondaryTextBrush}"/>
              </StackPanel>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="Your job drafts stay here while you navigate. Save a job to keep it for next time." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource LrSecondaryTextBrush}"/>
            <Button Content="Saved resumes →" Command="{Binding ViewArchiveCommand}" HorizontalAlignment="Stretch"/>
          </StackPanel>
        </Grid>
      </Border>
      <TabControl x:Name="JobWorkspaceTabs" Grid.Column="1" SelectedIndex="{Binding WorkspaceTab, Mode=TwoWay}" Margin="20,14">
        <TabItem FontSize="14" x:Name="JobDetailsTab" Header="Job details">
          <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,12,0,0" IsEnabled="{Binding !IsWorkingOnJob}">
            <StackPanel Spacing="4" Margin="0,0,0,10">
              <TextBlock Text="{Binding JobHeading}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding JobStep}" FontSize="12" Foreground="{DynamicResource LrSecondaryTextBrush}"/>
            </StackPanel>
            <TextBox x:Name="ProjectionJobDescription" Grid.Row="1" Text="{Binding JobDescriptionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" FontSize="14" Padding="16"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     PlaceholderText="Paste the full job description here. Include the role title, company and requirements if available."/>
            <Grid Grid.Row="2" ColumnDefinitions="*,12,Auto" Margin="0,12,0,0">
              <TextBox x:Name="JobTrackingUrlInput" Text="{Binding JobSourceUrl}" PlaceholderText="LinkedIn / advert URL for tracking (optional)"/>
              <Button x:Name="ExtractJobDetailsButton" Grid.Column="2" Content="Extract details" Command="{Binding ExtractJobDetailsCommand}" Padding="16,8"/>
            </Grid>
            <Grid Grid.Row="3" ColumnDefinitions="*,12,*" Margin="0,12,0,0" IsVisible="{Binding HasReviewedDetails}">
              <StackPanel Spacing="5">
                <TextBlock Text="Role title · required" FontSize="12"/>
                <TextBox x:Name="ProjectionJobTitle" Text="{Binding JobTitle}" PlaceholderText="What is the role called?"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="5">
                <TextBlock Text="Company · required" FontSize="12"/>
                <TextBox x:Name="ProjectionCompany" Text="{Binding Company}" PlaceholderText="Which company is hiring?"/>
              </StackPanel>
            </Grid>
            <WrapPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0" IsVisible="{Binding HasReviewedDetails}">
              <Button x:Name="SaveTargetJobButton" Content="Save job" Command="{Binding SaveJobCommand}" Margin="0,0,8,6"/>
              <Button x:Name="CreateJobResumeButton" Content="Create resume →" Command="{Binding CreateResumeCommand}" Margin="0,0,8,6"
                      Background="{DynamicResource LrAccentBlueBrush}" Foreground="White" Padding="18,10"/>
              <Button Content="Track application" Command="{Binding TrackJobCommand}" Margin="0,0,0,6"/>
            </WrapPanel>
          </Grid>
        </TabItem>
        <TabItem FontSize="14" x:Name="JobResumeTab" Header="Resume">
          <Grid RowDefinitions="Auto,*,Auto" Margin="0,12,0,0">
            <StackPanel Spacing="10" Margin="0,0,0,12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Resume for this job" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="ProjectResumeButton" Grid.Column="1" Content="Create / update resume" Command="{Binding CreateResumeCommand}"
                        IsEnabled="{Binding !IsTailoring}" Background="{DynamicResource LrAccentBlueBrush}" Foreground="White"/>
              </Grid>
              <Expander Header="Length, style and evidence references" HorizontalAlignment="Stretch">
                <StackPanel Spacing="8" Margin="0,8,0,0">
                  <Grid ColumnDefinitions="*,10,*,10,*">
                    <StackPanel Spacing="4"><TextBlock Text="Length" FontSize="12"/><ComboBox x:Name="ProjectionLengthSelector" ItemsSource="{Binding LengthOptions}" SelectedItem="{Binding SelectedLength}" HorizontalAlignment="Stretch"/></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Detail" FontSize="12"/><ComboBox x:Name="ProjectionDetailSelector" ItemsSource="{Binding DetailOptions}" SelectedItem="{Binding SelectedDetail}" HorizontalAlignment="Stretch"/></StackPanel>
                    <StackPanel Grid.Column="4" Spacing="4"><TextBlock Text="Tone" FontSize="12"/><ComboBox x:Name="ProjectionToneSelector" ItemsSource="{Binding ToneOptions}" SelectedItem="{Binding SelectedTone}" HorizontalAlignment="Stretch"/></StackPanel>
                  </Grid>
                  <ComboBox x:Name="OutputTemplateSelector" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" HorizontalAlignment="Stretch"/>
                  <CheckBox Content="Include evidence references in the document" IsChecked="{Binding IncludeCompactJobMl}"/>
                </StackPanel>
              </Expander>
              <Border IsVisible="{Binding EvidenceWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Background="{DynamicResource LrAccentYellowBgBrush}" CornerRadius="6" Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding EvidenceWarning}" TextWrapping="Wrap" FontSize="12"/>
                  <Button Content="Add detail in My career →" Command="{Binding EditCareerCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsVisible="{Binding ShowEmptyResult}">
              <TextBlock Text="Your tailored resume will appear here." FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="Uses the experience you saved in My career." FontSize="13" Foreground="{DynamicResource LrSecondaryTextBrush}" TextWrapping="Wrap"/>
              <Button Content="Review my career" Command="{Binding EditCareerCommand}" HorizontalAlignment="Center"/>
            </StackPanel>
      <ScrollViewer Grid.Row="1" IsVisible="{Binding HasInterview}" Background="{DynamicResource LrPageBgBrush}">
        <StackPanel Spacing="10" Margin="12" IsEnabled="{Binding !IsTailoring}">
          <Button x:Name="ReturnToProjectionButton" Content="Back to projected resume" Command="{Binding CloseInterviewCommand}" IsVisible="{Binding HasResult}"/>
          <TextBlock Text="Build your role transcript" FontSize="18" FontWeight="Bold"/>
          <TextBlock Text="{Binding InterviewRemaining, StringFormat='Remaining topics: {0}'}" FontSize="12"/>
          <TextBlock Text="{Binding InterviewRequirement}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding InterviewReason}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding InterviewEvidence}" TextWrapping="Wrap" FontStyle="Italic"/>
          <TextBlock Text="{Binding InterviewProbe}" TextWrapping="Wrap"/>
          <TextBlock Text="Which role is this example from?"/>
          <ComboBox x:Name="InterviewRole" ItemsSource="{Binding InterviewRoles}" SelectedItem="{Binding SelectedInterviewRole}" HorizontalAlignment="Stretch"/>
          <TextBlock Text="What was the situation, scope or challenge?" TextWrapping="Wrap"/>
          <TextBox x:Name="InterviewContext" Text="{Binding InterviewContext}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65"/>
          <TextBlock Text="What did you personally do? Include your decisions, tools and contribution alongside the team's." TextWrapping="Wrap"/>
          <TextBox x:Name="InterviewAction" Text="{Binding InterviewAction}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65"/>
          <TextBlock Text="What changed as a result? Use a reliable metric or a concrete qualitative outcome. Leave unknown details blank." TextWrapping="Wrap"/>
          <TextBox x:Name="InterviewOutcome" Text="{Binding InterviewOutcome}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65"/>
          <Expander Header="Optional structured facts" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6">
              <TextBox Text="{Binding InterviewOwnership}" PlaceholderText="Your ownership: assisted, individual, team or led"/>
              <TextBox Text="{Binding InterviewObject}" PlaceholderText="The service, workflow or product you changed"/>
              <TextBox Text="{Binding InterviewDecision}" PlaceholderText="Your decision, alternatives and constraints"/>
              <TextBox Text="{Binding InterviewDeliveryStatus}" PlaceholderText="Prototype, pilot, production, ongoing or unknown"/>
              <TextBox Text="{Binding InterviewQualifiers}" PlaceholderText="Limitations or uncertainty; separate with semicolons"/>
              <TextBlock Text="These facts stay with the reviewed role account. Leave unknown fields blank; generation remains available." TextWrapping="Wrap" FontSize="11"/>
            </StackPanel>
          </Expander>
          <Border Background="{DynamicResource LrCardBgBrush}" Padding="10" CornerRadius="6">
            <StackPanel Spacing="6">
              <TextBlock Text="Suggested next question" FontWeight="SemiBold"/>
              <ProgressBar IsVisible="{Binding IsAssessingInterview}" IsIndeterminate="True"/>
              <TextBlock x:Name="InterviewNextQuestion" Text="{Binding InterviewNextQuestion}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding InterviewFeedback}" TextWrapping="Wrap" FontSize="11"/>
              <Button Content="Assess answer now" Command="{Binding AssessInterviewCommand}"/>
            </StackPanel>
          </Border>
          <TextBlock Text="Which skills and tools did you actually use? Separate names with commas; saving records them for this role." TextWrapping="Wrap"/>
          <TextBox Text="{Binding InterviewSkills}" PlaceholderText="e.g. Azure Service Bus, C#, OpenTelemetry"/>
          <Button Content="Assemble a prose draft" Command="{Binding DraftInterviewProseCommand}"/>
          <TextBlock Text="Edit and review the account below. Saving adds it to the selected role's complete transcript for future resumes." TextWrapping="Wrap"/>
          <TextBox x:Name="InterviewReviewedProse" Text="{Binding InterviewProse}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"/>
          <Button Content="Save reviewed prose to role" Command="{Binding AcceptInterviewCommand}" IsEnabled="{Binding !IsTailoring}"/>
          <Button Content="Skip this question" Command="{Binding SkipInterviewCommand}" IsEnabled="{Binding !IsTailoring}"/>
          <Button Content="Project with current evidence" IsVisible="{Binding !IsTranscriptBuilder}" Command="{Binding ProjectWithCurrentEvidenceCommand}" IsEnabled="{Binding !IsTailoring}"/>
        </StackPanel>
      </ScrollViewer>


            <Border Grid.Row="1" IsVisible="{Binding ShowProjectedResult}" Background="{DynamicResource LrCardBgBrush}" CornerRadius="6">
              <controls:MarkdownViewer x:Name="ProjectedResumeText" Markdown="{Binding TailoredMarkdown}" Margin="16"/>
            </Border>
            <WrapPanel Grid.Row="2" Orientation="Horizontal" IsVisible="{Binding HasResult}" Margin="0,12,0,0">
              <Button x:Name="ExportWordButton" Content="Save Word…" Command="{Binding ExportCommand}" CommandParameter="docx" Margin="0,0,8,0"/>
              <Button x:Name="ExportPdfButton" Content="Save PDF…" Command="{Binding ExportCommand}" CommandParameter="pdf" Margin="0,0,8,0"/>
              <Button x:Name="ExportMarkdownButton" Content="Save Markdown…" Command="{Binding ExportCommand}" CommandParameter="markdown"/>
            </WrapPanel>
          </Grid>
        </TabItem>
        <TabItem FontSize="14" x:Name="JobRequirementsTab" Header="Requirements">
          <ScrollViewer>
            <StackPanel Spacing="12" Margin="0,12,0,0">
              <TextBlock Text="Requirements and source text" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock Text="Extract details after changing the advert. Required and preferred requirements are kept separate; benefits and rejected extraction are excluded from matching." FontSize="12" TextWrapping="Wrap"/>
              <ItemsControl ItemsSource="{Binding RequirementReview}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:JobRequirementReview">
                    <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource LrCardBgBrush}" CornerRadius="6">
                      <StackPanel Spacing="5">
                        <TextBlock Text="{Binding Priority}" FontSize="11" Foreground="{DynamicResource LrSecondaryTextBrush}"/>
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SourceText}" FontSize="12" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Expander Header="Excluded extraction" HorizontalAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding ExcludedExtraction}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:JobRequirementReview">
                      <StackPanel Spacing="4" Margin="0,8">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Priority}" FontSize="11"/>
                        <TextBlock Text="{Binding SourceText}" FontSize="12" TextWrapping="Wrap"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
    <Border Grid.Row="2" Padding="20,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LrBorderBrush}">
      <StackPanel Spacing="4">
        <ProgressBar IsVisible="{Binding IsTailoring}" IsIndeterminate="True" Height="3"/>
        <ProgressBar IsVisible="{Binding IsWorkingOnJob}" IsIndeterminate="True" Height="3"/>
        <TextBlock x:Name="ProjectionStatus" Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource LrSecondaryTextBrush}"/>
        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource LrAccentRedBrush}"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
