{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lucidresume.dev/schemas/jobml-0.1.schema.json",
  "title": "JobML 0.1",
  "description": "Evidence-linked, machine-readable claims embedded beside a human-readable resume.",
  "type": "object",
  "required": ["jobml", "document", "entities", "claims", "concepts"],
  "properties": {
    "jobml": {
      "type": "object",
      "required": ["version", "purpose", "semantics"],
      "properties": {
        "version": { "const": "0.1" },
        "purpose": { "type": "string", "minLength": 1 },
        "semantics": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "document": {
      "type": "object",
      "required": ["id", "language"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "language": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" }
      }
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "concepts": {
      "type": "array",
      "items": { "$ref": "#/$defs/concept" }
    },
    "job": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "$ref": "#/$defs/id" } }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "concept", "importance"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "concept": { "$ref": "#/$defs/id" },
          "importance": { "enum": ["required", "preferred"] }
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced extension payloads. Core JobML processors preserve but do not interpret unknown namespaces.",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
      },
      "properties": {
        "lucidresume.github": { "$ref": "#/$defs/githubExtension" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
    },
    "entity": {
      "type": "object",
      "required": ["id", "type", "name", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "pattern": "^#" }
      }
    },
    "claim": {
      "type": "object",
      "required": ["id", "subject", "statement", "supported_by"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "subject": { "$ref": "#/$defs/id" },
        "statement": { "type": "string", "minLength": 1 },
        "concepts": {
          "type": "object",
          "properties": {
            "skills": { "$ref": "#/$defs/idList" },
            "capabilities": { "$ref": "#/$defs/idList" },
            "domains": { "$ref": "#/$defs/idList" }
          }
        },
        "supported_by": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "origin": { "enum": ["declared", "derived"] },
        "review": { "enum": ["required", "accepted", "rejected"] }
      }
    },
    "idList": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" }
    },
    "evidence": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "pattern": "^#" },
        "uri": { "type": "string", "format": "uri" },
        "issuer": { "type": "string" },
        "qualification": { "type": "string" },
        "fingerprint": {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": { "type": "string", "pattern": "^fnv1a64:[0-9a-fA-F]{16}$" }
          }
        },
        "selector": {
          "type": "object",
          "required": ["type", "exact"],
          "properties": {
            "type": { "const": "TextQuoteSelector" },
            "exact": { "type": "string", "minLength": 1 },
            "prefix": { "type": "string" },
            "suffix": { "type": "string" }
          }
        },
        "state": { "enum": ["valid", "changed", "missing", "ambiguous", "external"] }
      },
      "anyOf": [
        { "required": ["ref"] },
        { "required": ["uri"] },
        { "required": ["qualification"] }
      ]
    },
    "concept": {
      "type": "object",
      "required": ["id", "type", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "githubExtension": {
      "type": "object",
      "required": ["version", "repositories"],
      "properties": {
        "version": { "const": "0.1" },
        "repositories": {
          "type": "array",
          "items": { "$ref": "#/$defs/githubRepository" }
        }
      }
    },
    "githubRepository": {
      "type": "object",
      "required": ["id", "provider", "uri", "revision", "observed_at"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "provider": { "const": "github" },
        "uri": { "type": "string", "format": "uri" },
        "revision": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
        "observed_at": { "type": "string", "format": "date-time" },
        "visibility": { "enum": ["public", "private", "unknown"] },
        "fork": { "type": "boolean" },
        "archived": { "type": "boolean" },
        "attribution": { "$ref": "#/$defs/githubAttribution" },
        "observations": { "$ref": "#/$defs/githubObservations" },
        "quality_assessments": {
          "type": "array",
          "items": { "$ref": "#/$defs/qualityAssessment" }
        },
        "skill_observations": {
          "type": "array",
          "items": { "$ref": "#/$defs/skillObservation" }
        }
      }
    },
    "githubAttribution": {
      "type": "object",
      "required": ["relationship", "confidence"],
      "properties": {
        "login": { "type": "string" },
        "relationship": { "enum": ["owner", "member", "contributor", "fork-only", "unknown"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "commit_count": { "type": "integer", "minimum": 0 },
        "first_commit": { "type": "string", "format": "date-time" },
        "last_commit": { "type": "string", "format": "date-time" }
      }
    },
    "githubObservations": {
      "type": "object",
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "bytes", "fraction", "source"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "bytes": { "type": "integer", "minimum": 0 },
              "fraction": { "type": "number", "minimum": 0, "maximum": 1 },
              "source": { "const": "github-linguist" }
            }
          }
        },
        "topics": { "type": "array", "items": { "type": "string" } },
        "manifests": { "type": "array", "items": { "type": "string" } },
        "direct_dependencies": { "type": "array", "items": { "type": "string" } },
        "workflows": { "type": "array", "items": { "type": "string" } },
        "community_health_percentage": { "type": "integer", "minimum": 0, "maximum": 100 },
        "license_spdx": { "type": "string" },
        "stars": { "type": "integer", "minimum": 0 }
      }
    },
    "qualityAssessment": {
      "type": "object",
      "required": ["method", "method_version", "observed_at"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "method_version": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "format": "date-time" },
        "score": { "type": "number" },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "score"],
            "properties": {
              "name": { "type": "string" },
              "score": { "type": "number" },
              "reason": { "type": "string" },
              "documentation_uri": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    "skillObservation": {
      "type": "object",
      "required": ["concept", "basis", "confidence", "state"],
      "properties": {
        "concept": { "$ref": "#/$defs/id" },
        "basis": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["language", "topic", "readme", "manifest", "direct-dependency", "workflow", "source-usage", "commit-attribution"] }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "state": { "enum": ["observed", "inferred", "reviewed", "rejected"] },
        "paths": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    }
  }
}
